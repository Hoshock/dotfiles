{
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bat *)",
      "Bash(chezmoi diff*)",
      "Bash(chezmoi managed*)",
      "Bash(chezmoi status*)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git push)",
      "Bash(git rev-parse*)",
      "Bash(git status*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(ty *)",
      "Bash(which *)",
      "Read(~/Projects/dotfiles/*)",
      "Read(~/.claude/skills/*)",
      "WebFetch",
      "WebSearch",
      "mcp__aws-pricing-mcp-server__*",
      "mcp__context7__*"
    ],
    "ask": [
      "Bash(rm *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/chezmoi-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-aws-config.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-aws-readonly-profile.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-aws-config.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "hoshock@wni-claude-code-marketplace": true,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "ncpd@wni-claude-code-marketplace": true,
    "code-review@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "wni-claude-code-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/weathernews/WNI-Claude-Code-Marketplace.git"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
