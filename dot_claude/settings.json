{
  "permissions": {
    "allow": [
      "Bash(bat *)",
      "Bash(chezmoi diff*)",
      "Bash(chezmoi managed*)",
      "Bash(chezmoi status*)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git rev-parse*)",
      "Bash(git status*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(ty *)",
      "Bash(which *)",
      "Read(~/Projects/dotfiles/*)",
      "Read(~/.claude/skills/*)",
      "WebSearch",
      "mcp__aws-pricing-mcp-server__*",
      "mcp__context7__*"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm *)",
      "WebFetch(*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-permission.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "ncpd@ncpd-claude-code-marketplace": true
  },
  "extraKnownMarketplaces": {
    "ncpd-claude-code-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/weathernews/NCPD-Claude-Code-Marketplace.git"
      }
    }
  },
  "language": "Japanese",
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true
}
