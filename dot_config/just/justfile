hostname := `scutil --get LocalHostName`
projects := "${HOME}/Projects"
workspace := "${HOME}/Projects/Workspace"
nixdir := "${HOME}/.config/nix"

default:
    @just -g -l

# ================================
#              Git
# ================================

# Create a new GitHub repo with bare repository structure
[group('git')]
init owner repo visibility: && (clone owner repo)
    gh repo create {{ owner }}/{{ repo }} {{ visibility }} --add-readme

# Update and prune git branches
[group('git')]
prune:
    #!/usr/bin/env bash
    set -euo pipefail

    BASE_DIR=$(just -g wt-find 2>/dev/null || echo "")
    if [ -n "${BASE_DIR}" ]; then
      GIT_DIR="${BASE_DIR}/repo.git"

      git -C "${GIT_DIR}" fetch --all --prune

      MERGED=$(git -C "${GIT_DIR}" branch --merged=main | grep -v main | grep -v '[*+]' || true)
      if [ -n "${MERGED}" ]; then
        echo "${MERGED}" | while read -r branch; do
          branch=$(echo "${branch}" | xargs)
          WORKTREE_NAME=$(echo "${branch}" | tr '/' '-')
          if [ -d "${BASE_DIR}/${WORKTREE_NAME}" ]; then
            just -g wt-del "${branch}"
          else
            git -C "${GIT_DIR}" branch -d "${branch}"
          fi
        done
      fi
    else
      git fetch --all --prune

      MERGED=$(git branch --merged=main | grep -v main | grep -v '[*+]' || true)
      if [ -n "${MERGED}" ]; then
        echo "${MERGED}" | xargs git branch -d
      fi
    fi

# Clone repository (mode: normal or worktree)
[group('git')]
clone owner repo mode="normal":
    #!/usr/bin/env bash
    set -euo pipefail

    BASE_DIR="{{ projects }}/{{ repo }}"

    if [ "{{ mode }}" = "worktree" ]; then
      mkdir -p "${BASE_DIR}"
      git clone --bare --single-branch --branch main "https://github.com/{{ owner }}/{{ repo }}.git" "${BASE_DIR}/repo.git"
      git -C "${BASE_DIR}/repo.git" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
      git -C "${BASE_DIR}/repo.git" fetch origin
      git -C "${BASE_DIR}/repo.git" worktree add ../main
      git -C "${BASE_DIR}/main" branch --set-upstream-to=origin/main main
    else
      git clone "https://github.com/{{ owner }}/{{ repo }}.git" "${BASE_DIR}"
    fi

# Find the base directory of the git worktree
[group('git')]
wt-find:
    #!/usr/bin/env bash
    set -euo pipefail

    # First, try git rev-parse (fastest if in a worktree)
    BARE_REPO=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
    if [ -n "${BARE_REPO}" ] && [ "${BARE_REPO}" != ".git" ]; then
      BARE_REPO=$(cd "${BARE_REPO}" && pwd)
    else
      BARE_REPO=""
    fi

    # If not found, search upwards for repo.git
    if [ -z "${BARE_REPO}" ]; then
      CURRENT_DIR="$(pwd)"
      while [ "$CURRENT_DIR" != "/" ] && [ "$CURRENT_DIR" != "{{ projects }}" ]; do
        if [ -d "${CURRENT_DIR}/repo.git" ]; then
          BARE_REPO="${CURRENT_DIR}/repo.git"
          break
        fi
        CURRENT_DIR=$(dirname "$CURRENT_DIR")
      done
    fi

    if [ -z "${BARE_REPO}" ]; then
      echo "Error: Could not find repo.git directory" >&2
      exit 1
    fi

    # Return the parent directory of repo.git
    dirname "${BARE_REPO}"

# Add a new git worktree for a branch
[group('git')]
wt-add branch from="":
    #!/usr/bin/env bash
    set -euo pipefail

    BASE_DIR=$(just -g wt-find)
    WORKTREE_NAME=$(echo "{{ branch }}" | tr '/' '-')

    if [ -n "{{ from }}" ]; then
      # Create new local branch from specified branch
      git -C "${BASE_DIR}/repo.git" worktree add -b "{{ branch }}" "${BASE_DIR}/${WORKTREE_NAME}" "{{ from }}"
      if git -C "${BASE_DIR}/${WORKTREE_NAME}" rev-parse --abbrev-ref "{{ branch }}@{upstream}" &>/dev/null; then
        git -C "${BASE_DIR}/${WORKTREE_NAME}" branch --unset-upstream "{{ branch }}"
      fi
    else
      # Create from remote branch
      git -C "${BASE_DIR}/repo.git" worktree add "${BASE_DIR}/${WORKTREE_NAME}" "{{ branch }}"
    fi

# Remove a git worktree for a branch
[group('git')]
wt-del branch:
    #!/usr/bin/env bash
    set -euo pipefail

    BASE_DIR=$(just -g wt-find)
    WORKTREE_NAME=$(echo "{{ branch }}" | tr '/' '-')
    git -C "${BASE_DIR}/repo.git" worktree remove "${WORKTREE_NAME}"
    git -C "${BASE_DIR}/repo.git" worktree prune
    git -C "${BASE_DIR}/repo.git" branch -D "{{ branch }}"

# Open VS Code workspace for a git worktree branch
[group('git')]
wt-open branch workspace="default":
    #!/usr/bin/env bash
    set -euo pipefail

    BASE_DIR=$(just -g wt-find)
    WORKTREE_NAME=$(echo "{{ branch }}" | tr '/' '-')
    code -r "${BASE_DIR}/${WORKTREE_NAME}/.workspace/{{ workspace }}.code-workspace"

# ================================
#              Nix
# ================================

# Apply nix-darwin configuration
[group('nix')]
darwin:
    sudo darwin-rebuild switch --flake {{ nixdir }}#{{ hostname }}

# Apply garbage collection to nix store
[group('nix')]
gc:
    nix store gc

# Install tools managed outside nix
[group('nix')]
install:
    bash {{ projects }}/dotfiles/install.sh

# Update dotfiles and apply nix-darwin configuration
[group('nix')]
update flag="partial":
    chezmoi diff
    chezmoi apply
    {{ if flag == "full" { "just -g install" } else { "" } }}
    nix flake update --flake {{ nixdir }}
    @just -g darwin
    brew upgrade
    nix store gc
    brew cleanup

# ================================
#            Claude
# ================================

# Run Claude in a worktree for reviewing a remote branch
[group('claude')]
claude-rev branch *args:
    #!/usr/bin/env bash
    set -euo pipefail

    cd {{ invocation_directory() }}
    WORKTREE_NAME=$(echo "{{ branch }}" | tr '/' '-')
    WORKTREE_DIR=".claude/worktrees/${WORKTREE_NAME}"

    if [ ! -d "${WORKTREE_DIR}" ]; then
      git worktree add "${WORKTREE_DIR}" "{{ branch }}"
    fi

    cd "${WORKTREE_DIR}"
    if scutil --dns 2>/dev/null | grep -q "wni.co.jp"; then
      NODE_EXTRA_CA_CERTS="$HOME/FortiSASE/Fortinet_CA_SSL_SASE+FG.cer" claude {{ args }}
    else
      claude {{ args }}
    fi

