{
  "*.nix.tmpl": {
    "filetype": "nix"
  },
  "colorscheme": "github-dark-dimmed",
  "eofnewline": true,
  "hltaberrors": true,
  "hltrailingws": true,
  "rmtrailingws": true,
  "softwrap": true,
  "statusformatl": "$(initlua.shortname) $(modified)($(line),$(col)) | $(opt:filetype)",
  "statusformatr": "$(opt:copilot.model)",
  "wordwrap": true
}
